{
    "compilerOptions":  {
                            "target":  "ESNext",
                            "useDefineForClassFields":  true,
                            "lib":  [
                                        "DOM",
                                        "DOM.Iterable",
                                        "ESNext"
                                    ],
                            "allowJs":  false,
                            "skipLibCheck":  true,
                            "esModuleInterop":  false,
                            "allowSyntheticDefaultImports":  true,
                            "strict":  true,
                            "forceConsistentCasingInFileNames":  true,
                            "module":  "ESNext",
                            "moduleResolution":  "Node",
                            "resolveJsonModule":  true,
                            "isolatedModules":  true,
                            "noEmit":  true,
                            "jsx":  "react-jsx",
                            "baseUrl":  ".",
                            "paths":  {
                                          "@/*":  [
                                                      "src/*"
                                                  ]
                                      }
                        },
    "include":  [
                    "src/main.tsx",
                    "src/vite-env.d.ts"
                ],
    "references":  [
                       {
                           "path":  "./tsconfig.node.json"
                       }
                   ],
    "exclude":  [
                    "src/**/*-backup.*",
                    "src/**/*_backup.*",
                    "src/**/*-old.*",
                    "src/pages/opinioni/EnergiaNucleare.tsx",
                    "src/pages/opinioni/SperimentazioneAnimale.tsx",
                    "src/pages/opinioni/LegalizzazioneCanapa.tsx",
                    "src/pages/opinioni/Caccia.tsx"
                ]
}
