{
  "name": "demos-app",
  "version": "1.0.0",
  "description": "DEMOS - App per la democrazia partecipativa",
  "main": "api/server.js",
  "scripts": {
    "start": "node --expose-gc api/server.js",
    "dev": "nodemon --exec \"node --expose-gc\" api/server.js",
    "build": "cd client && npm install && npm run build",
    "install-client": "cd client && npm install",
    "install-server": "npm install",
    "install-all": "npm run install-server && npm run install-client",
    "deploy": "npm run install-all && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "recharts": "^3.2.1",
    "resend": "^2.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "democrazia",
    "partecipativa",
    "voto",
    "elezioni"
  ],
  "author": "DEMOS Team",
  "license": "MIT"
}
