{
  "compilerOptions": {
    "outDir": "dist",
    "module": "NodeNext",
    "target": "ES2022",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@db/*": ["db/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["server/**/*.ts", "db/**/*.ts", "shared/**/*.ts"],
  "exclude": ["node_modules"]
}