{
  "extends": "./tsconfig.json", // Eredita le impostazioni base
  "compilerOptions": {
    "noEmit": false, // <-- QUESTA È LA MODIFICA CHIAVE: ora crea i file .js
    "module": "NodeNext", // Modulo corretto per Node.js
    "moduleResolution": "NodeNext",
    "outDir": "dist" // Mette i file .js compilati in una cartella 'dist'
  },
  "include": ["src/server/**/*.ts"], // Compila solo i file del server
  "exclude": ["node_modules"]
}