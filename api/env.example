# ===========================================
# 🔒 CONFIGURAZIONE API SICURA
# ===========================================

# Database Neon PostgreSQL (OBBLIGATORIO)
DATABASE_URL=postgresql://username:password@host.db.neon.tech/neondb?sslmode=require

# JWT Secret per autenticazione (GENERA UNA CHIAVE SICURA)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# Porta server
PORT=3001

# Ambiente (development in locale; in produzione usa NODE_ENV=production + GDPR_LOGGING_FILTER=true, vedi env.example nella root)
NODE_ENV=development

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# API AI per spiegazioni delle votazioni (scegli UNA delle due opzioni)

# Opzione 1: Groq API (GRATUITO - CONSIGLIATO) ⭐
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile  # Opzionale, default: llama-3.3-70b-versatile (llama-3.1-70b-versatile è stato decommissionato)

# Opzione 2: OpenAI API (A PAGAMENTO)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_DAILY_LIMIT=50  # Massimo numero di spiegazioni generate al giorno (solo per OpenAI, default: 50)

# API ufficiali EU per ECI (citizens-initiative.europa.eu). Se l'API restituisce 404, la Commissione potrebbe aver spostato gli endpoint.
# Override con EU_ECI_ONGOING_URL e EU_ECI_ALL_URL quando conosci i nuovi URL (es. da documentazione o ispezione rete sul portale).
# EU_ECI_API_BASE=https://citizens-initiative.europa.eu
# EU_ECI_ONGOING_URL=https://citizens-initiative.europa.eu/api/register/search/ONGOING/IT/0/100
# EU_ECI_ALL_URL=https://citizens-initiative.europa.eu/api/register/search/ALL/IT/0/200

# Decidim GraphQL API per ECI (alternativa alle API EU). Le ECI su Decidim sono Proposals dentro uno spazio partecipativo (assembly).
# DECIDIM_GRAPHQL_URL=https://citizens.ec.europa.eu/participation/api
# DECIDIM_ECI_ASSEMBLY_ID=3

# Se né API EU né Decidim sono disponibili, la pagina ECI userà i dati dalla tabella Neon "eci" (creare con database/create-eci-table.sql)