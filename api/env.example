# ===========================================
# 🔒 CONFIGURAZIONE API SICURA
# ===========================================

# Database Neon PostgreSQL (OBBLIGATORIO)
# Per meno compute: usa l'host "-pooler" se Neon lo offre e stringa dedicata al pooler.
DATABASE_URL=postgresql://username:password@host.db.neon.tech/neondb?sslmode=require
# Pool (default max=100 min=10). Su Neon Free conviene ridurre — es. min=0 max=15–25 — per non tenere il compute sveglio.
# DATABASE_POOL_MIN=0
# DATABASE_POOL_MAX=20

# JWT Secret per autenticazione (GENERA UNA CHIAVE SICURA)
JWT_SECRET=[REDACTED_JWT_SECRET]

# Porta server
PORT=3001

# Ambiente (development in locale; in produzione usa NODE_ENV=production + GDPR_LOGGING_FILTER=true, vedi env.example nella root)
NODE_ENV=development

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# PerformanceOptimizer
# ENABLE_PERFORMANCE_OPTIMIZER=false — disattiva tutto (prima il timer metriche restava attivo: bug corretto).
# PERFORMANCE_OPTIMIZER_METRICS_ENABLED=false — loop ogni 30s sì, ma nessun COUNT su users / errori (zero carico DB/Axiom da questo timer).
# PERFORMANCE_OPTIMIZER_LIGHT_METRICS=true — con metriche abilitate: aggiorna solo memoria/pool in processo, nessuna query users né Axiom/Neon per errori.
# Intervallo (ms) per le metriche “pesanti” (default 60000). Valori bassi aumentano molto il compute Neon.
# PERFORMANCE_OPTIMIZER_METRICS_INTERVAL_MS=60000

# PerformanceMonitor: riduzione carico DB/Neon/Axiom.
# PERFORMANCE_MONITOR_ENABLED=true
# PERFORMANCE_MONITOR_INTERVAL_MS=120000
# Ogni quanti tick: size DB + pg_stat_statements (default 10).
# PERFORMANCE_MONITOR_HEAVY_DB_METRICS_EVERY_N_TICKS=10
# Nessuna connessione/query Postgres per metriche DB (soglie admin usano ultimo snapshot o zeri).
# PERFORMANCE_MONITOR_DB_METRICS_ENABLED=false
# Nessun conteggio errori da Axiom/Neon (alert errori disattivati lato dati).
# PERFORMANCE_MONITOR_ERROR_METRICS_ENABLED=false
# Aggiorna conteggi errori solo ogni N tick (es. 6 con intervallo 120s ≈ ogni 12 min). Riduce molto le query Axiom.
# PERFORMANCE_MONITOR_ERROR_METRICS_EVERY_N_TICKS=1
# Limite righe lette da Axiom per il conteggio errori/warning (default 10000; prima era 100000).
# PERFORMANCE_MONITOR_AXIOM_LOGS_LIMIT=10000

# --- Preset “meno compute Neon” (pool vedi sopra; resto copia su .env / hosting se ti serve) ---
# PERFORMANCE_MONITOR_INTERVAL_MS=300000
# PERFORMANCE_MONITOR_ERROR_METRICS_EVERY_N_TICKS=6
# PERFORMANCE_OPTIMIZER_LIGHT_METRICS=true
# PERFORMANCE_OPTIMIZER_METRICS_INTERVAL_MS=300000

# Health check DB: per default in produzione NON fa COUNT(*) su users (riduce query inutili).
# HEALTHCHECK_DB_INCLUDE_COUNTS=false

# Fase 1 — metriche richieste per endpoint (memoria; GET /api/admin/monitoring/request-endpoints)
# REQUEST_METRICS_ENABLED=true
# Limite massimo chiavi distinte (pattern route) — oltre, nuove route non vengono aggiunte fino a reset/restart.
# REQUEST_METRICS_MAX_KEYS=800

# API AI per spiegazioni delle votazioni (scegli UNA delle due opzioni)

# Opzione 1: Groq API (GRATUITO - CONSIGLIATO) ⭐
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile  # Opzionale, default: llama-3.3-70b-versatile (llama-3.1-70b-versatile è stato decommissionato)

# Opzione 2: OpenAI API (A PAGAMENTO)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_DAILY_LIMIT=50  # Massimo numero di spiegazioni generate al giorno (solo per OpenAI, default: 50)

# API ufficiali EU per ECI (citizens-initiative.europa.eu). Endpoint con query params.
# Override con EU_ECI_ONGOING_URL e EU_ECI_ALL_URL se la Commissione cambia gli URL.
# EU_ECI_API_BASE=https://citizens-initiative.europa.eu
# EU_ECI_ONGOING_URL=https://citizens-initiative.europa.eu/api/initiatives/search?section=ONGOING&language=it&page=0&pageSize=100
# EU_ECI_ALL_URL=https://citizens-initiative.europa.eu/api/initiatives/search?section=ALL&language=it&page=0&pageSize=100

# Decidim GraphQL API per ECI (alternativa alle API EU). Le ECI su Decidim sono Proposals dentro uno spazio partecipativo (assembly).
# DECIDIM_GRAPHQL_URL=https://citizens.ec.europa.eu/participation/api
# DECIDIM_ECI_ASSEMBLY_ID=3

# Se né API EU né Decidim sono disponibili, la pagina ECI userà i dati dalla tabella Neon "eci" (creare con database/create-eci-table.sql)