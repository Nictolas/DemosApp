# ===========================================
# 🔒 CONFIGURAZIONE API SICURA
# ===========================================

# Database Neon PostgreSQL (OBBLIGATORIO)
DATABASE_URL=postgresql://username:password@host.db.neon.tech/neondb?sslmode=require

# JWT Secret per autenticazione (GENERA UNA CHIAVE SICURA)
JWT_SECRET=[REDACTED_JWT_SECRET]

# Porta server
PORT=3001

# Ambiente
NODE_ENV=development

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# API AI per spiegazioni delle votazioni (scegli UNA delle due opzioni)

# Opzione 1: Groq API (GRATUITO - CONSIGLIATO) ⭐
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile  # Opzionale, default: llama-3.3-70b-versatile (llama-3.1-70b-versatile è stato decommissionato)

# Opzione 2: OpenAI API (A PAGAMENTO)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_DAILY_LIMIT=50  # Massimo numero di spiegazioni generate al giorno (solo per OpenAI, default: 50)