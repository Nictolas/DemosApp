# ===========================================
# 🔒 CONFIGURAZIONE SICURA DEMOSAPP
# ===========================================

# Database Neon PostgreSQL (OBBLIGATORIO)
DATABASE_URL=postgresql://username:password@host.db.neon.tech/neondb?sslmode=require

# JWT Secret per autenticazione (GENERA UNA CHIAVE SICURA)
JWT_SECRET=[REDACTED_JWT_SECRET]

# Google OAuth (opzionale)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Firebase Admin SDK (opzionale)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Resend Email Service
RESEND_API_KEY=your-resend-api-key

# Ambiente
NODE_ENV=development

# Porta server
PORT=3001

# SSL Certificate (solo se necessario)
SSL_CERT_PATH=/path/to/ssl/cert.pem

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log