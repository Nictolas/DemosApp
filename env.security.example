# Configurazione Sistema di Sicurezza e Conformità GDPR
# Copia questo file come .env e configura le variabili

# ===========================================
# CONFIGURAZIONE SICUREZZA
# ===========================================

# Abilita sistema di audit logging
AUDIT_ENABLED=true

# Abilita data retention automatico
ENABLE_DATA_RETENTION=true

# Abilita monitoraggio violazioni
ENABLE_VIOLATION_MONITORING=true

# ===========================================
# CONFIGURAZIONE AUDIT LOGGING
# ===========================================

# Intervallo pulizia log (ore)
AUDIT_CLEANUP_INTERVAL_HOURS=24

# Intervallo controllo attività sospette (ore)
AUDIT_SUSPICIOUS_CHECK_INTERVAL_HOURS=1

# Giorni di retention per i log
AUDIT_LOG_RETENTION_DAYS=365

# ===========================================
# CONFIGURAZIONE NOTIFICHE
# ===========================================

# Email degli amministratori (separate da virgola)
ADMIN_EMAILS=admin@demos.community,security@demos.community

# Email per escalation (separate da virgola)
ESCALATION_EMAILS=admin@demos.community,cto@demos.community

# ===========================================
# CONFIGURAZIONE DATABASE
# ===========================================

# URL del database PostgreSQL (Neon)
DATABASE_URL=postgresql://username:password@host:port/database

# ===========================================
# CONFIGURAZIONE EMAIL
# ===========================================

# API Key per Resend (per notifiche)
RESEND_API_KEY=your_resend_api_key_here

# ===========================================
# CONFIGURAZIONE SICUREZZA AVANZATA
# ===========================================

# Soglie per notifiche violazioni
VIOLATION_THRESHOLD_CRITICAL=1
VIOLATION_THRESHOLD_HIGH=3
VIOLATION_THRESHOLD_MEDIUM=10

# Abilita notifiche email per violazioni
ENABLE_VIOLATION_NOTIFICATIONS=true

# Abilita escalation automatica
ENABLE_ESCALATION=true

# ===========================================
# CONFIGURAZIONE GDPR
# ===========================================

# Abilita diritti utente GDPR
ENABLE_GDPR_RIGHTS=true

# Abilita consenso esplicito
ENABLE_EXPLICIT_CONSENT=true

# Abilita logging consensi
ENABLE_CONSENT_LOGGING=true

# ===========================================
# CONFIGURAZIONE MONITORAGGIO
# ===========================================

# Intervallo monitoraggio violazioni (minuti)
VIOLATION_MONITORING_INTERVAL_MINUTES=5

# Abilita riepilogo giornaliero
ENABLE_DAILY_SUMMARY=true

# Orario riepilogo giornaliero (formato 24h)
DAILY_SUMMARY_HOUR=9

# ===========================================
# CONFIGURAZIONE BACKUP
# ===========================================

# Abilita backup automatico
ENABLE_AUTOMATIC_BACKUP=true

# Frequenza backup (ore)
BACKUP_INTERVAL_HOURS=24

# Retention backup (giorni)
BACKUP_RETENTION_DAYS=30

# ===========================================
# CONFIGURAZIONE LOGGING
# ===========================================

# Livello di log (debug, info, warn, error)
LOG_LEVEL=info

# Abilita logging dettagliato
ENABLE_DETAILED_LOGGING=true

# ===========================================
# CONFIGURAZIONE SICUREZZA RETE
# ===========================================

# Abilita rate limiting
ENABLE_RATE_LIMITING=true

# Limite richieste per minuto
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Abilita protezione DDoS
ENABLE_DDOS_PROTECTION=true

# ===========================================
# CONFIGURAZIONE CONFORMITÀ
# ===========================================

# Abilita conformità GDPR completa
ENABLE_FULL_GDPR_COMPLIANCE=true

# Abilita conformità ISO 27001
ENABLE_ISO_27001_COMPLIANCE=false

# Abilita conformità SOC 2
ENABLE_SOC2_COMPLIANCE=false

# ===========================================
# CONFIGURAZIONE ALERTING
# ===========================================

# Abilita alerting Slack
ENABLE_SLACK_ALERTS=false
SLACK_WEBHOOK_URL=your_slack_webhook_url

# Abilita alerting Discord
ENABLE_DISCORD_ALERTS=false
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# Abilita alerting Telegram
ENABLE_TELEGRAM_ALERTS=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
