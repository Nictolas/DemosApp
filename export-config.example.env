# Configurazione Export Dati su Hard Disk
# Copia questo file come .env e configura le tue impostazioni

# Directory di destinazione per l'export
# Su Windows: C:\external-drive\archivio
# Su Linux/Mac: /mnt/external-drive/archivio
EXPORT_DIR=/mnt/external-drive/archivio

# Configurazione compressione
EXPORT_COMPRESSION_ENABLED=true
EXPORT_COMPRESSION_LEVEL=6

# Formato file (csv o json)
EXPORT_FORMAT=csv

# Dimensione massima file in MB
EXPORT_MAX_FILE_SIZE=100

# Batch size per query
EXPORT_BATCH_SIZE=10000

# Policy di retention (in giorni)
RETENTION_SECURITY_EVENTS=30
RETENTION_PERFORMANCE_METRICS=7
RETENTION_CENTRALIZED_LOGS=14
RETENTION_ACCESS_AUDIT=30
RETENTION_AUDIT_LOGS=30

# Abilita eliminazione automatica dopo export
EXPORT_DELETE_AFTER=false

# Abilita modalità dry-run per test
EXPORT_DRY_RUN=false

# Configurazione notifiche
EXPORT_NOTIFICATIONS_ENABLED=true
EXPORT_NOTIFICATION_EMAIL=admin@demosapp.it

# Configurazione backup
EXPORT_BACKUP_ENABLED=true
EXPORT_BACKUP_RETENTION_DAYS=90
