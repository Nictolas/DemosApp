{
  "functions": {
    "server/index.ts": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/server/index.ts"
    },
    {
      "source": "/:path((?!api/|assets/|icona.png|manifest.json).*)",
      "destination": "/index.html"
    }
  ]
} 