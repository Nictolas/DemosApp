# Configurazione Cloud Storage per Backup Export
# Copia questo file come .env e configura le tue impostazioni

# Provider cloud storage: 's3', 'gcs', 'b2', 'azure'
CLOUD_STORAGE_PROVIDER=s3

# ============================================
# AWS S3 Configuration
# ============================================
# Crea bucket su: https://console.aws.amazon.com/s3/
# Regione consigliata: eu-west-1 (Irlanda) per GDPR
AWS_S3_BUCKET=demosapp-log-archive
AWS_S3_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# ============================================
# Google Cloud Storage Configuration
# ============================================
# Crea bucket su: https://console.cloud.google.com/storage
# Regione consigliata: europe-west1 (Belgio) per GDPR
GCS_BUCKET=demosapp-log-archive
GCS_KEY_FILE=path/to/service-account-key.json

# ============================================
# Backblaze B2 Configuration
# ============================================
# Crea bucket su: https://www.backblaze.com/b2/cloud-storage.html
# Regione consigliata: EU (per GDPR)
B2_BUCKET=demosapp-log-archive
B2_KEY_ID=your-key-id
B2_APPLICATION_KEY=your-application-key

# ============================================
# Azure Blob Storage Configuration
# ============================================
# Crea storage account su: https://portal.azure.com
# Regione consigliata: West Europe (Paesi Bassi) per GDPR
AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_KEY=your-storage-key
AZURE_CONTAINER_NAME=log-archive

# ============================================
# Configurazione GDPR
# ============================================
# Chiave per crittografia file (genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
EXPORT_ENCRYPTION_KEY=your-encryption-key-here

# Salt per hash identificatori (genera con: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))")
EXPORT_HASH_SALT=your-hash-salt-here

# Abilita anonimizzazione GDPR
EXPORT_ANONYMIZE_ENABLED=true

# Abilita crittografia file
EXPORT_ENCRYPTION_ENABLED=true

# ============================================
# Configurazione Backup Automatico
# ============================================
# Abilita backup cloud automatico dopo export
CLOUD_BACKUP_ENABLED=false

# Backup solo file nuovi (ultimi N giorni)
CLOUD_BACKUP_NEW_FILES_ONLY=true
CLOUD_BACKUP_NEW_FILES_DAYS=7

# ============================================
# Note Importanti
# ============================================
# 1. Per AWS S3:
#    - Installa AWS CLI: https://aws.amazon.com/cli/
#    - Configura credenziali: aws configure
#
# 2. Per Google Cloud Storage:
#    - Installa gcloud CLI: https://cloud.google.com/sdk/docs/install
#    - Crea service account e scarica key JSON
#
# 3. Per Backblaze B2:
#    - Installa b2 CLI: pip install b2
#    - Autentica: b2 authorize-account <keyId> <applicationKey>
#
# 4. Per Azure Blob Storage:
#    - Installa Azure CLI: https://docs.microsoft.com/cli/azure/install-azure-cli
#    - Autentica: az login
#
# 5. GDPR:
#    - Genera chiavi di crittografia sicure
#    - Conserva chiavi in luogo sicuro (password manager)
#    - Non committare questo file nel repository

