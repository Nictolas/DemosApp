# Configurazione Database
DATABASE_URL=postgresql://username:password@host:port/database

# Configurazione JWT
JWT_SECRET=[REDACTED_JWT_SECRET]

# Configurazione Frontend
FRONTEND_URL=https://www.demos.community

# Configurazione Email (Resend)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Demos Community <noreply@demos.community>

# Configurazione Ambiente
NODE_ENV=production

# Configurazione CORS
CORS_ORIGINS=http://localhost:3000,https://www.demos.community,https://demos.community

# Configurazione Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configurazione CIE (Carta d'Identità Elettronica) - OIDC
# In sviluppo, usa il Mock Server interno (http://localhost:PORT/api/auth/mock-cie)
# In produzione, usa l'URL reale del provider CIE del Ministero dell'Interno
CIE_ISSUER_URL=http://localhost:3001/api/auth/mock-cie
# Oppure usa OIDC_ISSUER_URL (ha priorità se presente)
# OIDC_ISSUER_URL=https://cie-provider-url

# Credenziali OIDC (Client ID e Secret forniti dal provider CIE)
CIE_CLIENT_ID=your-cie-client-id
CIE_CLIENT_SECRET=your-cie-client-secret
# Oppure usa OIDC_CLIENT_ID e OIDC_CLIENT_SECRET (hanno priorità se presenti)
# OIDC_CLIENT_ID=your-oidc-client-id
# OIDC_CLIENT_SECRET=your-oidc-client-secret

# URL di callback per OIDC (dove l'Identity Provider reindirizza dopo l'autenticazione)
CIE_REDIRECT_URI=http://localhost:3001/api/auth/cie/callback
# Oppure usa OIDC_REDIRECT_URI (ha priorità se presente)
# OIDC_REDIRECT_URI=https://www.demos.community/api/auth/cie/callback

# Abilita Mock Server CIE (solo per sviluppo)
# Imposta a 'true' per abilitare il mock server anche in altri ambienti
USE_MOCK_CIE=false

# Configurazione Auth.js
NEXTAUTH_URL=https://www.demos.community
NEXTAUTH_SECRET=your-nextauth-secret-key

# ============================================
# AXIOM CONFIGURATION - REGIONE EU
# ============================================

# Abilita/disabilita invio log ad Axiom
AXIOM_ENABLED=true

# API Token Axiom (ottieni da: Settings -> API Tokens)
# Crea un token con permessi "Ingest" e "Query"
AXIOM_API_TOKEN=your-axiom-api-token-here

# Organization ID Axiom (ottieni da: Settings -> Organization)
AXIOM_ORG_ID=your-org-id-here

# Dataset Axiom per log applicativi (tutti i livelli)
AXIOM_DATASET=centralized_logs

# Dataset Axiom per dati real-time (performance + security + audit)
AXIOM_REALTIME_DATASET=real-time

# ⚠️ REGIONE: 'eu' per Europa (GDPR compliant)
# Opzioni: 'eu' (Europa), 'us' (USA), 'us-fips' (USA FIPS)
AXIOM_REGION=eu

# ============================================
# GDPR - Anonimizzazione Dati
# ============================================

# Anonimizza IP address (solo rete, es. 192.168.1.0)
# Imposta a 'true' per conformità GDPR
AXIOM_ANONYMIZE=true

# Hash user_id con SHA-256 (pseudonimizzazione)
# Imposta a 'true' per conformità GDPR
AXIOM_ANONYMIZE_USER_ID=true

# Salt per hash (usa un valore casuale sicuro)
# Genera con: openssl rand -hex 32
EXPORT_HASH_SALT=your-secure-random-salt-here