# ========================================
# CONFIGURAZIONE VERCEL POSTGRES
# ========================================

# URL di connessione al database Vercel Postgres
POSTGRES_URL=postgresql://username:password@host:port/database

# Configurazione alternativa (se non usi POSTGRES_URL)
POSTGRES_HOST=your-vercel-postgres-host
POSTGRES_DATABASE=your-vercel-postgres-database
POSTGRES_USERNAME=your-vercel-postgres-username
POSTGRES_PASSWORD=your-vercel-postgres-password
POSTGRES_PORT=5432

# ========================================
# CONFIGURAZIONE AUTH.JS (NEXTAUTH)
# ========================================

# Chiave segreta per NextAuth (genera con: openssl rand -base64 32)
NEXTAUTH_SECRET=your-nextauth-secret-key
NEXTAUTH_URL=https://your-domain.vercel.app

# Provider Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ========================================
# CONFIGURAZIONE FIREBASE (PER MIGRAZIONE)
# ========================================

# Credenziali Firebase Admin SDK (solo per migrazione dati)
FIREBASE_PROJECT_ID=demos-finale
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Firebase Private Key\n-----END PRIVATE KEY-----\n"

# ========================================
# CONFIGURAZIONE DATABASE KELIWEB (PER MIGRAZIONE)
# ========================================

# Credenziali database sorgente (Keliweb)
DB_USER=xeadylil_Nicolas
DB_PASSWORD=N1Nj6tAu789
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xeadylil_demos
DB_SSL=false

# ========================================
# CONFIGURAZIONE APP
# ========================================

# Ambiente di esecuzione
NODE_ENV=production

# URL dell'applicazione
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Configurazione CORS
NEXT_PUBLIC_API_URL=https://your-domain.vercel.app/api

# ========================================
# CONFIGURAZIONE NOTIFICHE
# ========================================

# Firebase Cloud Messaging (opzionale, per notifiche push)
FIREBASE_MESSAGING_SENDER_ID=848085963511
FIREBASE_APP_ID=1:848085963511:web:2efb3d13fb5576ecd0b9f2

# ========================================
# CONFIGURAZIONE ANALYTICS
# ========================================

# Google Analytics (opzionale)
NEXT_PUBLIC_GA_ID=G-HSP3FK0GFN

# ========================================
# CONFIGURAZIONE SICUREZZA
# ========================================

# Chiave per crittografia (genera con: openssl rand -base64 32)
ENCRYPTION_KEY=your-encryption-key

# Configurazione rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# ========================================
# CONFIGURAZIONE EMAIL (OPZIONALE)
# ========================================

# Provider email per notifiche
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-email@gmail.com
EMAIL_SERVER_PASSWORD=your-email-password
EMAIL_FROM=noreply@your-domain.com

# ========================================
# NOTE IMPORTANTI
# ========================================

# 1. Sostituisci tutti i valori "your-*" con i tuoi dati reali
# 2. Non committare mai questo file nel repository
# 3. Usa .env.local per sviluppo locale
# 4. Configura le variabili su Vercel Dashboard per produzione
# 5. Genera chiavi segrete sicure per NEXTAUTH_SECRET e ENCRYPTION_KEY
# 6. Configura Google OAuth su Google Cloud Console
# 7. Ottieni credenziali Firebase Admin SDK per la migrazione
