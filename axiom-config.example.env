# Configurazione Axiom per Analisi Log
# Copia questo file come .env e configura le tue impostazioni

# ============================================
# Axiom Configuration
# ============================================

# Abilita/disabilita invio log ad Axiom
AXIOM_ENABLED=true

# API Token Axiom (ottieni da: Settings -> API Tokens)
AXIOM_API_TOKEN=your-axiom-api-token-here

# Organization ID Axiom (ottieni da: Settings -> Organization)
AXIOM_ORG_ID=your-org-id-here

# Dataset Axiom (nome del dataset dove inviare i log)
AXIOM_DATASET=demosapp-logs

# Regione Axiom (eu, us, ecc.)
AXIOM_REGION=eu

# ============================================
# GDPR Configuration
# ============================================

# Abilita anonimizzazione automatica dei log
AXIOM_ANONYMIZE=true

# Anonimizza user_id (hash SHA-256)
AXIOM_ANONYMIZE_USER_ID=true

# Salt per hash user_id (genera con: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))")
AXIOM_HASH_SALT=your-hash-salt-here

# ============================================
# Note Importanti
# ============================================
# 1. Crea account Axiom: https://axiom.co/
# 2. Crea dataset: Dashboard -> Datasets -> New Dataset
# 3. Genera API Token: Settings -> API Tokens -> Create Token
# 4. Trova Org ID: Settings -> Organization
# 5. Tier gratuito: 500GB/mese, 30 giorni retention
# 6. GDPR: Usa regione EU per conformità
# 7. Non committare questo file nel repository (contiene token)

