# DEMOS Security Agent – environment template v0.88
# Safe defaults: everything disabled until separately approved.

SECURITY_AGENT_PROCESS_ENABLED=false
SECURITY_AGENT_SHADOW_ENABLED=false
SECURITY_AGENT_RUNNER_ENABLED=false
SECURITY_AGENT_RUNTIME_MODE=memory
SECURITY_AGENT_STAGING_ISOLATION_REQUIRED=false
SECURITY_AGENT_ENVIRONMENT_CLASS=staging
SECURITY_AGENT_STAGING_ID=demos-security-staging
SECURITY_AGENT_STORE_ENABLED=false
SECURITY_RETENTION_JOB_ENABLED=false
SECURITY_AGENT_ACTION_RUNNER_ENABLED=false
SECURITY_AGENT_RUN_IMMEDIATELY=false
SECURITY_AGENT_RUNNER_INTERVAL_MS=60000

AXIOM_ENABLED=false
AXIOM_API_TOKEN=external-secret-not-in-repo
AXIOM_ORG_ID=external-org-id
AXIOM_REGION=eu
AXIOM_REALTIME_DATASET=demos-security-staging

SECURITY_AI_ORCHESTRATOR_ENABLED=false
SECURITY_AI_SHADOW_INTEGRATION_ENABLED=false
SECURITY_AI_SHADOW_BACKEND=mock
SECURITY_AI_MODEL_GATEWAY_ENABLED=false
SECURITY_AI_PROVIDER_POLICY_APPROVED=false
SECURITY_AI_PROVIDER=groq
SECURITY_AI_REGION=global
SECURITY_AI_MODEL=openai/gpt-oss-120b
SECURITY_AI_PROVIDER_ALLOWLIST=groq
SECURITY_AI_REGION_ALLOWLIST=global
SECURITY_AI_MODEL_ALLOWLIST=openai/gpt-oss-120b
SECURITY_AI_TIMEOUT_MS=8000
SECURITY_AI_MAX_REQUEST_COST_MICROS=100
SECURITY_AI_DAILY_COST_BUDGET_MICROS=1000
SECURITY_AI_MAX_DAILY_REQUESTS=10
SECURITY_AI_GROQ_REQUEST_COST_ESTIMATE_MICROS=100
SECURITY_AI_GROQ_MAX_TOKENS=600
SECURITY_AI_PROVIDER_QUALITY_LIVE_ENABLED=false
SECURITY_AI_PROVIDER_QUALITY_MIN_PASS_RATE=0.8
GROQ_API_KEY=external-secret-not-in-repo

SECURITY_PHASE4_DEPLOYED_VALIDATION_ENABLED=false
SECURITY_PHASE4_STAGING_ORIGIN=https://security-staging.example.invalid
SECURITY_PHASE4_STAGING_HOST_ALLOWLIST=security-staging.example.invalid
SECURITY_PHASE4_SECURITY_CENTER_PREFIX=/api/security-center
SECURITY_PHASE4_VALIDATION_TIMEOUT_MS=8000
SECURITY_PHASE4_STAGING_ADMIN_TOKEN=external-secret-not-in-repo


SECURITY_CENTER_RUNTIME_ENABLED=false
SECURITY_CENTER_RUNTIME_PREFIX=/api/security-center
SECURITY_CENTER_STAGING_AUTH_ENABLED=false
SECURITY_CENTER_STAGING_ADMIN_TOKEN=external-secret-at-least-32-chars-not-in-repo
SECURITY_STAGING_SERVER_ENABLED=false

SECURITY_PHASE2_DEPLOYED_VALIDATION_ENABLED=false
SECURITY_PHASE2_DEPLOYED_VALIDATION_TOKEN=external-secret-at-least-32-chars-not-in-repo

SECURITY_PHASE2_RENDER_KV_ENABLED=false
SECURITY_PHASE2_RENDER_KV_ID=red-staging-example
SECURITY_PHASE2_RENDER_KV_URL=redis://red-staging-example:6379
