# DEMOS Security Agent – environment template v0.78
# Safe defaults: everything disabled until separately approved.

SECURITY_AGENT_PROCESS_ENABLED=false
SECURITY_AGENT_SHADOW_ENABLED=false
SECURITY_AGENT_RUNNER_ENABLED=false
SECURITY_AGENT_RUNTIME_MODE=memory
SECURITY_AGENT_RUN_IMMEDIATELY=false
SECURITY_AGENT_RUNNER_INTERVAL_MS=60000

AXIOM_ENABLED=false
AXIOM_API_TOKEN=external-secret-not-in-repo
AXIOM_ORG_ID=external-org-id
AXIOM_REGION=eu
AXIOM_REALTIME_DATASET=real-time

SECURITY_AI_ORCHESTRATOR_ENABLED=false
SECURITY_AI_SHADOW_INTEGRATION_ENABLED=false
SECURITY_AI_SHADOW_BACKEND=mock
SECURITY_AI_MODEL_GATEWAY_ENABLED=false
SECURITY_AI_PROVIDER_POLICY_APPROVED=false
SECURITY_AI_PROVIDER=groq
SECURITY_AI_REGION=global
SECURITY_AI_MODEL=llama-3.3-70b-versatile
SECURITY_AI_PROVIDER_ALLOWLIST=groq
SECURITY_AI_REGION_ALLOWLIST=global
SECURITY_AI_MODEL_ALLOWLIST=llama-3.3-70b-versatile
SECURITY_AI_TIMEOUT_MS=8000
SECURITY_AI_MAX_REQUEST_COST_MICROS=100
SECURITY_AI_DAILY_COST_BUDGET_MICROS=1000
SECURITY_AI_MAX_DAILY_REQUESTS=10
SECURITY_AI_GROQ_REQUEST_COST_ESTIMATE_MICROS=100
SECURITY_AI_GROQ_MAX_TOKENS=600
GROQ_API_KEY=external-secret-not-in-repo
